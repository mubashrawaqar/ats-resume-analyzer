# Copy this file to .env and fill in your key to enable LLM-based skill
# extraction (higher accuracy than the dictionary/keyword fallback).
# The app works fully without this — it just falls back to dictionary
# matching and shows a notice in the UI when no key is configured.
#
# Get a key at: https://console.anthropic.com/
GROQ_API_KEY=your-api-key-here
